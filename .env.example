# Archivo de ejemplo de variables de entorno
# Este archivo contiene las variables de entorno utilizadas en la aplicación.
# Copia este archivo como .env y ajusta los valores según tu entorno.

# URL base para la API (opcional, por defecto usa JSONPlaceholder)
MODERN_APP_API_BASE_URL=https://jsonplaceholder.typicode.com

# Modo de renderizado: SSR (Server Side Rendering) o CSR (Client Side Rendering)
MODERN_APP_RENDERING_MODE=SSR

# Entorno de la aplicación
MODERN_APP_ENVIRONMENT=development

# Variables estándar de Node.js
NODE_ENV=development

# Module Federation URLs
# URL del microfrontend host
MODERN_APP_HOST_URL=http://localhost:8000/mf-manifest.json