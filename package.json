    "playwright": "^1.57.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.2.3",
    "react-cookie": "^8.0.1",
    "react-dom": "^19.2.3",
